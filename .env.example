DATABASE_URL=postgresql://nuvio:nuvio@localhost:5432/nuvio
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-with-a-long-random-string
JWT_EXPIRES_IN=7d
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NODE_ENV=development

# --- To connect manually (left unset on purpose) ---
# Payments (orders) and billing (subscriptions): register a real provider in app.module.ts, then set these.
PAYMENT_PROVIDER=
PAYMENT_WEBHOOK_SECRET=
BILLING_PROVIDER=
BILLING_WEBHOOK_SECRET=
# First platform admin, created by `npm run seed -w @nuvio/api` (password >= 12 chars)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Phase 7: messaging (left unset on purpose) ---
# Email via Resend
RESEND_API_KEY=
EMAIL_FROM=
# WhatsApp Business Cloud API (Meta). Templates nuvio_order_confirmation, nuvio_appointment_confirmation,
# nuvio_appointment_reminder must be approved in Meta Business Manager (language es_MX).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Secret for the reminders scheduler: POST /api/v1/internal/cron/reminders with header x-cron-secret
CRON_SECRET=

# --- Phase 9: Nuvio AI (left unset on purpose) ---
ANTHROPIC_API_KEY=
# Optional: defaults to claude-haiku-4-5-20251001
AI_MODEL=
# Max AI requests per business per 24h (cost control)
AI_DAILY_LIMIT=30

# --- File uploads (S3-compatible: AWS S3, Cloudflare R2, MinIO...) ---
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
# Only for non-AWS providers (R2/MinIO), e.g. https://<account>.r2.cloudflarestorage.com
S3_ENDPOINT=
# Public base URL where uploaded files are served (bucket public URL or CDN)
S3_PUBLIC_BASE_URL=
