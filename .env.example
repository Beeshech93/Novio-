DATABASE_URL=postgresql://nuvio:nuvio@localhost:5432/nuvio
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-with-a-long-random-string
JWT_EXPIRES_IN=7d
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NODE_ENV=development

# --- To connect manually (left unset on purpose) ---
# Payments (orders) and billing (subscriptions): register a real provider in app.module.ts, then set these.
PAYMENT_PROVIDER=
PAYMENT_WEBHOOK_SECRET=
BILLING_PROVIDER=
BILLING_WEBHOOK_SECRET=
# First platform admin, created by `npm run seed -w @nuvio/api` (password >= 12 chars)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Phase 7: messaging (left unset on purpose) ---
# Email via Resend
RESEND_API_KEY=
EMAIL_FROM=
# WhatsApp Business Cloud API (Meta). Templates nuvio_order_confirmation, nuvio_appointment_confirmation,
# nuvio_appointment_reminder must be approved in Meta Business Manager (language es_MX).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Secret for the reminders scheduler: POST /api/v1/internal/cron/reminders with header x-cron-secret
CRON_SECRET=
